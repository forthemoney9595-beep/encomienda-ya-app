rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024 &&
             request.resource.contentType.matches('image/.*');
    }
    // OJO (Fase BB): `firestore.exists()`/`firestore.get()` -- lectura cruzada a Firestore
    // desde Storage Rules -- se probó en vivo contra el proyecto real y NO funciona de forma
    // confiable (falla incluso para admin, con datos verificados correctos). Por eso acá
    // NINGUNA regla depende de eso: todo se valida con el propio uid en el path, igual que
    // profiles/licenses de abajo (patrón probado y funcionando).
    function isAdmin() {
      return firestore.exists(/databases/(default)/documents/roles_admin/$(request.auth.uid));
    }

    // Avatares de perfil — visibles públicamente, pero cada quien solo puede escribir el
    // suyo. image-upload.tsx arma el path como profiles/{uid}/archivo (ownerId=user.uid);
    // antes cualquier logueado podía pisar el avatar de OTRO usuario.
    match /profiles/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid && isValidImage();
    }

    // Banners de tienda — visibles públicamente en /stores/{id}. Path:
    // store-banners/{uid}/archivo, donde {uid} es el uid del DUEÑO de la tienda (no el
    // storeId -- ver comentario en my-store/edit/page.tsx). Solo esas dos pantallas suben
    // acá y en ambas el que sube es siempre el dueño autenticado de la tienda.
    match /store-banners/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid && isValidImage();
    }

    // Fotos de productos — visibles públicamente en el catálogo. Path: products/{uid}/archivo
    // (uid del dueño de la tienda, mismo criterio que store-banners de arriba).
    match /products/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid && isValidImage();
    }

    // Licencias de conducir (DNI/carnet de repartidores) — documento sensible, NUNCA
    // público. El path incluye el uid del dueño (ver image-upload.tsx) para poder
    // restringir la escritura a ese mismo usuario.
    // OJO lectura (Fase BB): la app YA NO lee este archivo directo desde el cliente para
    // nada -- ni el propio repartidor en /profile ni el admin en el panel. Ambos piden una
    // URL firmada de 5 min a /api/licenses/signed-url, que usa el Admin SDK (bypasea esta
    // regla por completo, como cualquier ruta con Admin SDK). El `isAdmin()` de acá quedó
    // sin uso real (y de paso: no funciona -- ver nota en isAdmin() más arriba) pero se deja
    // por si algún día se lee directo desde el cliente.
    match /licenses/{uid}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == uid && isValidImage();
    }

    // Evidencia de reclamos del comprador (Fase NN) — foto del producto en mal estado /
    // producto equivocado. NO es pública: es evidencia de una disputa. Mismo patrón que
    // licenses/: el dueño sube a su propia carpeta (claims/{uid}/..., via image-upload.tsx
    // con storeRawPath) y la app nunca lee el archivo directo -- el admin y el propio
    // comprador lo ven con una URL firmada de 5 min via /api/claims/photo-url (Admin SDK).
    match /claims/{uid}/{allPaths=**} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isSignedIn() && request.auth.uid == uid && isValidImage();
    }

    // Cualquier otra ruta: denegado por defecto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
