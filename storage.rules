rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024 &&
             request.resource.contentType.matches('image/.*');
    }
    function isAdmin() {
      return firestore.exists(/databases/(default)/documents/roles_admin/$(request.auth.uid));
    }

    // Avatares de perfil — visibles públicamente (se muestran en la UI a otros usuarios)
    match /profiles/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isValidImage();
    }

    // Banners de tienda — visibles públicamente en /stores/{id}
    match /store-banners/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isValidImage();
    }

    // Fotos de productos — visibles públicamente en el catálogo
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && isValidImage();
    }

    // Licencias de conducir (DNI/carnet de repartidores) — documento sensible, NUNCA
    // público. El path incluye el uid del dueño (ver image-upload.tsx) para poder
    // restringir lectura/escritura a ese mismo usuario o a un admin.
    match /licenses/{uid}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == uid && isValidImage();
    }

    // Cualquier otra ruta: denegado por defecto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
