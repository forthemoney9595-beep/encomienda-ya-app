rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCIONES DE AYUDA (HELPERS) ---
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    // Nivel de admin (Fase DD): roles_admin/{uid}.level puede ser 'full' (default si el
    // campo no existe -- los admins creados antes de esta fase no pierden nada) o
    // 'support' (solo operativo). Exigido para plata, config, broadcast, borrar cuentas y
    // promover/degradar otros admins.
    function isFullAdmin() {
      return isAdmin() &&
        get(/databases/$(database)/documents/roles_admin/$(request.auth.uid)).data.get('level', 'full') != 'support';
    }
    // Un cambio de rol hacia o desde 'admin', o al campo adminLevel, es en sí mismo un acto
    // de otorgar/quitar privilegios -- no alcanza con ser admin 'support' para hacerlo (si
    // no, un admin 'support' podría promoverse a otra cuenta cómplice a full admin).
    function isAdminRoleChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminLevel']) ||
        request.resource.data.get('role', '') == 'admin' ||
        resource.data.get('role', '') == 'admin';
    }
    function isStoreOwner(storeId) {
      return get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
    }
    // Repartidor aprobado por el admin: solo estos pueden autoasignarse pedidos.
    // 🚨 El `role == 'delivery'` NO es redundante. `isApproved` es un campo COMPARTIDO: el
    // flujo de aprobación del admin (admin/page.tsx) lo escribe en `users/{uid}` tanto para
    // repartidores COMO para dueños de tienda. Sin el chequeo de rol, cualquier tienda
    // aprobada cumplía la condición de "repartidor aprobado" y podía autoasignarse pedidos
    // — incluso de tiendas COMPETIDORAS — con un write directo desde la consola.
    // Verificado en vivo antes del fix: "Farmacia del Pueblo" tomó un pedido de "Super Los
    // Aromos" y lo pasó a "En camino". La UI no muestra el botón, pero la regla lo permitía.
    function isApprovedDriver() {
      let u = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.isApproved == true && u.get('role', '') == 'delivery';
    }

    // --- REGLAS DE COLECCIONES ---

    // 1. CONFIGURACIÓN GLOBAL — cambiar fees/día de liquidación/mantenimiento es una
    // decisión de negocio, no una tarea operativa: exige admin 'full'.
    match /config/{configDoc} {
      allow read: if isSignedIn();
      allow write: if isFullAdmin();
    }

    // 2. ROLES ADMIN — solo el propio usuario puede leer su doc (para saber si es admin).
    // Escribir acá ES otorgar o quitar acceso de administrador -- solo 'full' puede
    // hacerlo (si 'support' pudiera, se autopromovería a sí mismo o a un cómplice).
    match /roles_admin/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if isFullAdmin();
    }

    // 3. USUARIOS Y PERFILES — Fase BB (seguridad): antes cualquier usuario logueado podía
    // reescribir CUALQUIER campo de su propio doc, incluido isApproved/role/rating. Un
    // repartidor podía auto-aprobarse (isApproved:true) y saltarse la aprobación del admin
    // (Fase O), o un comprador podía autopromoverse a role:'admin'. Ahora cada camino de
    // escritura está limitado a los campos que ese camino de verdad necesita (inventariado
    // contra TODO el código cliente: signup, /profile, toggles, panel admin).
    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);

      // CREATE: alta de cuenta (los 3 signup) o el fallback de login social que crea el
      // perfil si no existe. Nadie puede autocrearse como admin ni nacer ya aprobado.
      // OJO: en `create` NO existe `resource` (el doc anterior) todavía -- hay que validar
      // sobre request.resource.data.keys() directo, nunca con .diff(resource.data), que
      // fallaría siempre y rompería el alta de cuentas.
      allow create: if isSignedIn() && isOwner(userId) &&
        request.resource.data.role in ['buyer', 'store', 'delivery'] &&
        (!('isApproved' in request.resource.data) || request.resource.data.isApproved == false) &&
        request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'phoneNumber', 'role', 'addresses', 'storeId', 'isApproved',
          'dni', 'birthDate', 'vehicle', 'status', 'displayName', 'profileImageUrl', 'createdAt'
        ]);

      // ADMIN sobre el doc de cualquier usuario: aprobar/rechazar, cambiar rol, sincronizar
      // estado, CBU — acceso completo, igual que antes. O el PROPIO usuario sobre su doc,
      // pero limitado a perfil/direcciones/favoritos/disponibilidad/CBU/tokens: nunca puede
      // tocar isApproved/role/status/rating por este camino.
      allow update: if (isAdmin() && (!isAdminRoleChange() || isFullAdmin())) || (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'displayName', 'photoURL', 'profileImageUrl', 'phoneNumber',
          'vehicle', 'licenseUrl', 'licenseBackUrl', 'licenseSelfieUrl',
          'addresses', 'favoriteProducts', 'isOnline', 'payoutCbu',
          'fcmToken', 'fcmTokens', 'notificationsEnabled'
        ])
      );

      allow delete: if isAdmin();

      // Favoritos de tienda (subcolección aparte de favoriteProducts, que es un array en
      // el doc principal) — sin cambios: solo el propio dueño, y no hay campos sensibles.
      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 4. TIENDAS (Stores) — mismo criterio que users/{uid} arriba: antes el dueño podía
    // reescribir cualquier campo de su tienda, incluido isApproved (saltarse la aprobación
    // del admin) o rating/ratingCount (inflar su propio promedio sin pasar por una reseña real).
    match /stores/{storeId} {
      allow read: if true;

      // CREATE: alta desde /signup/store (el propio dueño) o alta manual del admin desde
      // el panel. El dueño nunca puede nacer ya aprobado.
      // Mismo cuidado que en users/{uid}: en `create` se valida con .keys(), no con
      // .diff(resource.data) (el doc anterior no existe todavía).
      allow create: if isAdmin() || (
        isSignedIn() && isOwner(request.resource.data.ownerId) &&
        (!('isApproved' in request.resource.data) || request.resource.data.isApproved == false) &&
        request.resource.data.keys().hasOnly([
          'name', 'category', 'address', 'cuit', 'maintenanceMode', 'isApproved', 'rating',
          'deliveryTime', 'minOrder', 'ownerId', 'ownerName', 'createdAt', 'productCategories',
          'imageUrl', 'imageHint', 'products', 'horario'
        ])
      );

      // ADMIN sobre cualquier tienda: acceso completo, igual que antes. O el PROPIO dueño
      // sobre SU PROPIA tienda: edición de perfil, horarios, pausa manual, categorías, CBU,
      // y el recálculo automático de maxDiscountPercent (Fase V). Nunca isApproved / rating
      // / ratingCount / ownerId / commissionRate por este camino.
      allow update: if isAdmin() || (
        isSignedIn() && isOwner(resource.data.ownerId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'description', 'category', 'address', 'imageUrl', 'deliveryTime',
          'weeklySchedule', 'schedule', 'coords', 'updatedAt', 'manuallyPaused',
          'productCategories', 'maxDiscountPercent', 'payoutCbu'
        ])
      );

      allow delete: if isAdmin();

      // Subcolección PRODUCTOS (Soportamos 'products' y 'items' por compatibilidad)
      match /products/{productId} {
        allow read: if true;
        allow write: if isAdmin() || isStoreOwner(storeId);
      }
      match /items/{itemId} {
        allow read: if true;
        allow write: if isAdmin() || isStoreOwner(storeId);
      }
    }

    // 5. PEDIDOS (Orders) - 🛡️ BLINDAJE FASE 4 🛡️
    match /orders/{orderId} {
      // ❌ CREATE: BLOQUEADO (Ahora usamos la API Segura en el Backend)
      // Nota: El chequeo de 'Mantenimiento' ahora debe hacerse en la API, no aquí.
      allow create: if false; 

      // 👁️ READ: Solo involucrados
      allow read, list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||           // Cliente
        isStoreOwner(resource.data.storeId) ||                // Tienda
        resource.data.deliveryPersonId == request.auth.uid || // Repartidor
        isAdmin() ||                                          // Admin
        // Repartidores buscando pedidos libres -- tiene que coincidir exacto con la
        // lista de estados que pide availableQuery en delivery-orders-view.tsx, si no
        // Firestore rechaza la consulta completa (no la filtra).
        (resource.data.status in ['En preparación', 'Listo para recoger'] && resource.data.deliveryPersonId == null)
      );

      // ✏️ UPDATE: Solo acciones permitidas — cada rol restringido a los campos y valores
      // que de verdad escribe directo (todo lo que toca total/items/pago pasa SIEMPRE por
      // las API seguras del Admin SDK, que no usan estas reglas).
      allow update: if isSignedIn() && (
        // ADMIN: acceso amplio PERO sin tocar los campos de dinero desde el cliente.
        // 🚨 Antes era `isAdmin()` a secas: un admin podía reescribir `total`, `items`,
        // `refunded` o `paymentStatus` de cualquier pedido desde la consola del navegador.
        // Como el saldo de tiendas y repartidores se deriva 100% de las órdenes, eso
        // equivalía a editar el saldo de cualquiera sin dejar rastro. Todo lo que toca
        // plata pasa por las API con Admin SDK (cancel / refund-order / confirm-stock),
        // que además dejan auditoría.
        (isAdmin() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'total', 'subtotal', 'serviceFee', 'deliveryFee', 'items',
            'paymentStatus', 'refunded', 'refundAmount', 'paidAmount'
          ])) ||

        // TIENDA: solo rechazar el pedido o marcarlo listo para retirar, y avisar al
        // repartidor. Total/items/pago: siempre por /api/orders/confirm-stock.
        // 🚨 `Rechazado` SOLO desde 'Pendiente de Confirmación': antes la regla no miraba el
        // estado actual, así que la tienda podía rechazar un pedido YA PAGADO desde la
        // consola. Eso dejaba `paymentStatus:'paid'` + `status:'Rechazado'` sin ningún
        // registro de que había plata del cliente para devolver.
        // 🚨 'Rechazado' ya NO se puede escribir desde el cliente: rechazar tiene que
        // devolver al catálogo las unidades que /api/orders/create reservó, y eso solo
        // puede pasar server-side. Ahora va por /api/orders/reject (Admin SDK). Si se
        // dejara esta rama abierta, cualquiera de los dos botones de rechazo podría
        // saltear la devolución y el stock quedaría descontado para siempre.
        (isStoreOwner(resource.data.storeId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'readyForPickup', 'lastDriverNotification']) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
            (request.resource.data.status == 'Listo para recoger' && resource.data.status == 'En preparación'))) ||

        // REPARTIDOR ASIGNADO: avanzar su propio pedido + reportar posición GPS
        // (driverCoords, sin tocar status — tiene que seguir siendo una escritura barata).
        (resource.data.deliveryPersonId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'pickedUpAt', 'deliveredAt', 'driverCoords']) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
            request.resource.data.status in ['En reparto', 'Entregado'])) ||

        // REPARTIDOR LIBRE: autoasignación de un pedido sin repartidor.
        // Solo repartidores APROBADOS por el admin (users/{uid}.isApproved == true).
        (resource.data.deliveryPersonId == null &&
          isApprovedDriver() &&
          request.resource.data.deliveryPersonId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['deliveryPersonId', 'deliveryPersonName', 'status', 'takenAt']) &&
          request.resource.data.status == 'En camino') ||

        // CLIENTE: solo puede calificar productos, y SOLO sobre el mapa `itemRatings`.
        // 🚨 Antes esto permitía escribir `items`, que es donde vive el PRECIO de cada
        // producto. Como /api/orders/confirm-stock recalculaba el subtotal desde ese array,
        // el comprador podía bajarse el precio a $1 antes de que la tienda confirmara y
        // pagar un pedido de $20.000 por $2.000 (el webhook validaba contra el total ya
        // alterado, así que ni siquiera quedaba registrado como anomalía).
        // Calificar al repartidor va por /api/delivery-reviews/create.
        (resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['itemRatings']) &&
          resource.data.status == 'Entregado')
      );
    }

    // 5b. RESEÑAS DE REPARTIDOR — solo vía /api/delivery-reviews/create (Admin SDK).
    // A diferencia de /reviews (tienda), no son públicas: no hay perfil público de
    // repartidor donde mostrarlas: solo el propio repartidor calificado y el admin
    // necesitan leerlas.
    match /deliveryReviews/{reviewId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.driverId == request.auth.uid);
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // 5c. INCIDENTES DE REPARTIDOR — soltar pedido / reportar problema, solo vía
    // /api/orders/release y /api/orders/report-problem (Admin SDK). Solo el admin las
    // lee (para detectar acaparamiento o repartidores problemáticos); el repartidor no
    // necesita ver su propio historial de incidentes acá.
    // Fase FF: el admin (cualquier nivel -- es trabajo operativo, no mueve plata) puede
    // marcarlos resueltos desde /admin/incidents, antes no había forma de hacerlo.
    match /driver_incidents/{incidentId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved', 'resolvedAt', 'resolvedBy']);
      allow delete: if isAdmin();
    }

    // 5c-bis. LOG DE ACCIONES ADMIN — BUG DE LARGA DATA (Fase GG): esta colección existe
    // desde la Fase N pero NUNCA tuvo regla, así que Firestore denegaba por defecto TODAS
    // las escrituras. Como logAdminAction() traga el error con un console.warn para no
    // romper la acción principal, el log quedaba siempre vacío sin ningún síntoma visible
    // (parecía "todavía no hubo acciones"). Ninguna acción sensible del panel quedó
    // registrada en todo ese tiempo.
    match /admin_audit_log/{entryId} {
      allow read: if isAdmin();
      // Un admin solo puede registrar acciones a su propio nombre: no puede fabricar
      // entradas atribuidas a otro admin.
      allow create: if isAdmin() && request.resource.data.adminUid == request.auth.uid;
      // Un log de auditoría no se edita ni se borra -- ni siquiera un admin 'full'. Si se
      // pudiera, dejaría de servir como evidencia de lo que pasó.
      allow update, delete: if false;
    }

    // 5c-ter. HISTORIAL DE BROADCASTS (Fase GG) — lo escribe /api/admin/notify-broadcast
    // con Admin SDK (por eso `create: false` acá: el cliente no puede fabricar registros de
    // envíos que nunca ocurrieron). Es un historial, no se edita ni se borra.
    match /broadcasts/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // 5d. DISCREPANCIAS DE PAGO — el webhook de MercadoPago (Admin SDK) deja acá los pagos
    // que no coinciden en monto o estado con la orden, para revisión manual (ver K1 en
    // CLAUDE.md). Fase FF: antes esta colección no tenía NINGUNA regla (ni el admin podía
    // leerla desde el panel; solo era visible entrando a la consola de Firestore a mano).
    match /payment_mismatches/{id} {
      allow read: if isAdmin();
      allow create: if false;
      // Marcar resuelto es metadata operativa (cualquier nivel de admin) -- el reembolso
      // real, si corresponde, sigue yendo por /api/admin/refund-order (exige 'full').
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved', 'resolvedAt', 'resolvedBy', 'resolutionNote']);
      allow delete: if isFullAdmin();
    }

    // 6. NOTIFICACIONES
    // create: cualquier usuario logueado puede crear -- es una función real (la tienda avisa
    // al repartidor, el repartidor al cliente, el chat de la orden, etc.), así que no se puede
    // restringir a "solo para mí mismo" sin romperla. Lo que SÍ se puede exigir es la FORMA del
    // documento: campos exactos (nada de payloads extra) y `type` de una lista cerrada (los
    // únicos valores que src/lib/order-service.ts y chat-window.tsx realmente usan) — sube la
    // vara contra spam/basura sin tocar la función legítima.
    // read/update/delete: solo el destinatario puede ver/marcar sus propias notificaciones
    match /notifications/{notifId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasAll(['userId', 'title', 'message', 'type', 'read', 'createdAt']) &&
        request.resource.data.keys().hasOnly(['userId', 'title', 'message', 'type', 'orderId', 'read', 'createdAt', 'icon']) &&
        request.resource.data.userId is string &&
        request.resource.data.title is string &&
        request.resource.data.message is string &&
        request.resource.data.read == false &&
        request.resource.data.type in ['order_status', 'delivery', 'buyer', 'store', 'admin'];
    }

    // 7. CHATS — solo participantes de la orden (cliente, tienda, repartidor, admin)
    match /order_chats/{orderId}/messages/{msgId} {
      allow read, create: if isSignedIn() && (
        isAdmin() ||
        get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/orders/$(orderId)).data.deliveryPersonId == request.auth.uid ||
        isStoreOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.storeId)
      );
    }

    // 8. RETIROS (Withdrawals) — solicitudes de pago a tiendas y repartidores
    match /withdrawals/{withdrawalId} {
      // 👁️ READ: el dueño de la solicitud o el admin
      allow read, list: if isSignedIn() && (isAdmin() || isOwner(resource.data.userId));

      // ✏️ CREATE: el usuario solo puede crear solicitudes propias, en estado 'pending'.
      // `hasOnly` es clave: sin él se podían sembrar campos de aprobación (approvedBy,
      // operationRef, balanceAtApproval, processedAt) en un doc recién creado, o marcarlo
      // como `source:'auto'` para que pareciera generado por el cron.
      // 🚨 CERRADO: la creación pasa 100% por /api/withdrawals/request (Admin SDK), que es
      // el único lugar donde se puede topear el monto contra el saldo real -- Firestore
      // Rules no puede sumar una colección, así que acá solo se podía validar `amount > 0`.
      // Con el create abierto, cualquiera creaba desde la consola un retiro de $99.999.999:
      // no cobraba de más (la aprobación recalcula), pero CONGELABA la liquidación
      // automática de esa cuenta, porque el cron saltea a quien ya tiene uno `pending`.
      allow create: if false;

      // ✏️ UPDATE: aprobar/rechazar es plata real -- exige admin 'full' Y solo los campos
      // del procesamiento. Antes era un update libre: se podía reescribir `amount` de un
      // retiro ya aprobado, o cambiar `userId`, sin dejar rastro en ningún lado.
      allow update: if isFullAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'processedAt', 'approvedBy', 'operationRef', 'adminNote',
          'balanceAtApproval', 'rejectionReason', 'rejectedBy'
        ]);

      // ❌ DELETE: bloqueado incluso para admin. Borrar un retiro 'approved' baja el
      // total retirado y le devuelve el saldo al usuario -> habilita cobrar dos veces la
      // misma plata, sin ninguna entrada en el log. Un registro de dinero no se borra.
      allow delete: if false;
    }

    // 9. RESEÑAS DE TIENDA
    match /reviews/{reviewId} {
      allow read: if true; // públicas, igual que las tiendas

      // ❌ CREATE: bloqueado, igual que orders -- va solo por /api/reviews/create
      // (verifica que el pedido sea del comprador, esté Entregado, y evita duplicados)
      allow create: if false;

      // La tienda solo puede agregar su respuesta, no tocar el resto de la reseña
      allow update: if isStoreOwner(resource.data.storeId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerReply', 'ownerReplyAt']);

      allow delete: if isAdmin();
    }
  }
}