rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- FUNCIONES DE AYUDA (HELPERS) ---
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function isAdmin() {
      return exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }
    function isStoreOwner(storeId) {
      return get(/databases/$(database)/documents/stores/$(storeId)).data.ownerId == request.auth.uid;
    }
    // Repartidor aprobado por el admin: solo estos pueden autoasignarse pedidos.
    function isApprovedDriver() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isApproved == true;
    }

    // --- REGLAS DE COLECCIONES ---

    // 1. CONFIGURACIÓN GLOBAL
    match /config/{configDoc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 2. ROLES ADMIN — solo el propio usuario puede leer su doc (para saber si es admin)
    match /roles_admin/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if isAdmin();
    }

    // 3. USUARIOS Y PERFILES
    match /users/{userId} {
      allow create: if isSignedIn() && isOwner(userId);
      allow read, update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin();

      // Mantenemos tu subcolección de Favoritos
      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 4. TIENDAS (Stores)
    match /stores/{storeId} {
      allow read: if true;
      allow create: if isSignedIn() && isOwner(request.resource.data.ownerId);
      allow update: if isAdmin() || (isSignedIn() && isOwner(resource.data.ownerId));
      allow delete: if isAdmin();

      // Subcolección PRODUCTOS (Soportamos 'products' y 'items' por compatibilidad)
      match /products/{productId} {
        allow read: if true;
        allow write: if isAdmin() || isStoreOwner(storeId);
      }
      match /items/{itemId} {
        allow read: if true;
        allow write: if isAdmin() || isStoreOwner(storeId);
      }
    }

    // 5. PEDIDOS (Orders) - 🛡️ BLINDAJE FASE 4 🛡️
    match /orders/{orderId} {
      // ❌ CREATE: BLOQUEADO (Ahora usamos la API Segura en el Backend)
      // Nota: El chequeo de 'Mantenimiento' ahora debe hacerse en la API, no aquí.
      allow create: if false; 

      // 👁️ READ: Solo involucrados
      allow read, list: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||           // Cliente
        isStoreOwner(resource.data.storeId) ||                // Tienda
        resource.data.deliveryPersonId == request.auth.uid || // Repartidor
        isAdmin() ||                                          // Admin
        // Repartidores buscando pedidos libres -- tiene que coincidir exacto con la
        // lista de estados que pide availableQuery en delivery-orders-view.tsx, si no
        // Firestore rechaza la consulta completa (no la filtra).
        (resource.data.status in ['En preparación', 'Listo para recoger'] && resource.data.deliveryPersonId == null)
      );

      // ✏️ UPDATE: Solo acciones permitidas — cada rol restringido a los campos y valores
      // que de verdad escribe directo (todo lo que toca total/items/pago pasa SIEMPRE por
      // las API seguras del Admin SDK, que no usan estas reglas).
      allow update: if isSignedIn() && (
        isAdmin() ||

        // TIENDA: solo rechazar el pedido o marcarlo listo para retirar, y avisar al
        // repartidor. Total/items/pago: siempre por /api/orders/confirm-stock.
        (isStoreOwner(resource.data.storeId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'readyForPickup', 'lastDriverNotification']) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
            request.resource.data.status in ['Rechazado', 'Listo para recoger'])) ||

        // REPARTIDOR ASIGNADO: avanzar su propio pedido + reportar posición GPS
        // (driverCoords, sin tocar status — tiene que seguir siendo una escritura barata).
        (resource.data.deliveryPersonId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'pickedUpAt', 'deliveredAt', 'driverCoords']) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) ||
            request.resource.data.status in ['En reparto', 'Entregado'])) ||

        // REPARTIDOR LIBRE: autoasignación de un pedido sin repartidor.
        // Solo repartidores APROBADOS por el admin (users/{uid}.isApproved == true).
        (resource.data.deliveryPersonId == null &&
          isApprovedDriver() &&
          request.resource.data.deliveryPersonId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['deliveryPersonId', 'deliveryPersonName', 'status', 'takenAt']) &&
          request.resource.data.status == 'En camino') ||

        // CLIENTE: solo puede calificar productos (rating por item), no otros campos.
        // Calificar al repartidor ya NO es un campo de escritura directa -- va por
        // /api/delivery-reviews/create (mismo criterio que calificar la tienda), que
        // valida Entregado y evita calificar dos veces antes de tocar la orden.
        (resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items']))
      );
    }

    // 5b. RESEÑAS DE REPARTIDOR — solo vía /api/delivery-reviews/create (Admin SDK).
    // A diferencia de /reviews (tienda), no son públicas: no hay perfil público de
    // repartidor donde mostrarlas: solo el propio repartidor calificado y el admin
    // necesitan leerlas.
    match /deliveryReviews/{reviewId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.driverId == request.auth.uid);
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // 6. NOTIFICACIONES
    // create: cualquier usuario logueado puede crear (tienda notifica al delivery, etc.)
    // read/update/delete: solo el destinatario puede ver/marcar sus propias notificaciones
    match /notifications/{notifId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn();
    }

    // 7. CHATS — solo participantes de la orden (cliente, tienda, repartidor, admin)
    match /order_chats/{orderId}/messages/{msgId} {
      allow read, create: if isSignedIn() && (
        isAdmin() ||
        get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/orders/$(orderId)).data.deliveryPersonId == request.auth.uid ||
        isStoreOwner(get(/databases/$(database)/documents/orders/$(orderId)).data.storeId)
      );
    }

    // 8. RETIROS (Withdrawals) — solicitudes de pago a tiendas y repartidores
    match /withdrawals/{withdrawalId} {
      // 👁️ READ: el dueño de la solicitud o el admin
      allow read, list: if isSignedIn() && (isAdmin() || isOwner(resource.data.userId));

      // ✏️ CREATE: el usuario solo puede crear solicitudes propias, en estado 'pending'
      allow create: if isSignedIn() &&
        isOwner(request.resource.data.userId) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0;

      // ✏️ UPDATE/DELETE: solo el admin puede aprobar, rechazar o eliminar
      allow update, delete: if isAdmin();
    }

    // 9. RESEÑAS DE TIENDA
    match /reviews/{reviewId} {
      allow read: if true; // públicas, igual que las tiendas

      // ❌ CREATE: bloqueado, igual que orders -- va solo por /api/reviews/create
      // (verifica que el pedido sea del comprador, esté Entregado, y evita duplicados)
      allow create: if false;

      // La tienda solo puede agregar su respuesta, no tocar el resto de la reseña
      allow update: if isStoreOwner(resource.data.storeId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerReply', 'ownerReplyAt']);

      allow delete: if isAdmin();
    }
  }
}